# Backend Performa Demo — Gotong Royong
# Salin ke .env sebelum menjalankan:  cp .env.example .env

# --- Postgres (via compose.yaml) ---
# App pakai PgBouncer di 6432 untuk pooling; direct Postgres di 5432 untuk migrasi/seed
DATABASE_URL=postgres://demo:demo123@localhost:6432/gotongroyong_demo
DATABASE_DIRECT_URL=postgres://demo:demo123@localhost:5432/gotongroyong_demo

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- App ---
NODE_ENV=development
LOG_LEVEL=info
# LOG_LEVEL: trace|debug|info|warn|error|fatal  (Pino)
# Di dev: pretty print otomatis. Di prod: JSON ke stdout -> Alloy -> Loki

# --- Service Ports ---
ORDER_SERVICE_PORT=3001
PAYMENT_SERVICE_PORT=3002
UMKM_SERVICE_PORT=3003
KAS_SERVICE_PORT=3004

# --- Observability (profile observability) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=backend-performa-demo
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
GRAFANA_URL=http://localhost:3000
JAEGER_URL=http://localhost:16686

# --- CDC & Search (profile cdc) ---
KAFKA_BROKERS=localhost:9092
KAFKA_BROKERS_INTERNAL=kafka:29092
DEBEZIUM_URL=http://localhost:8083
ELASTICSEARCH_URL=http://localhost:9200
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=gotongroyong_demo

# --- Load Test ---
LOAD_TARGET_URL=http://localhost:3001
LOAD_RPS=50
LOAD_DURATION_SEC=30

# --- Seed CSV paths (untuk laptop lain, set path lokal) ---
CSV_UMKM=./data/Pesanggrahan.csv
CSV_MASJID=./data/Masjid.csv
# Fallback absolut: /home/ngome/GotongRoyong/Docs-wa/Data Kecamatan Pesanggrahan.xlsx.Pesanggrahan.csv
