{
  "name": "backend-performa-demo",
  "private": true,
  "version": "0.1.0",
  "description": "Backend Performa Demo \u2014 Gotong Royong (Logging + Performa, 4 branch + 05 CDC). Rp0-friendly, Podman/Docker lokal.",
  "type": "module",
  "workspaces": [
    "order-service",
    "payment-service",
    "umkm-service",
    "kas-service",
    "load",
    "seed"
  ],
  "scripts": {
    "seed": "bun run --cwd seed seed.ts",
    "dev": "bun run --cwd order-service dev & bun run --cwd payment-service dev & bun run --cwd umkm-service dev & bun run --cwd kas-service dev",
    "dev:order": "bun run --cwd order-service dev",
    "dev:payment": "bun run --cwd payment-service dev",
    "dev:umkm": "bun run --cwd umkm-service dev",
    "dev:kas": "bun run --cwd kas-service dev",
    "load": "bun run --cwd load index.ts",
    "load:k6": "k6 run load/k6.js",
    "lint": "tsc --noEmit",
    "format": "prettier --check .",
    "migrate": "bun run --cwd seed migrate.ts",
    "verify:ledger": "bun run --cwd kas-service verify.ts"
  },
  "dependencies": {
    "@faker-js/faker": "8.4.0",
    "@prisma/client": "^5.22.0",
    "compression": "^1.7.4",
    "csv-parse": "^5.5.0",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "pg-copy-streams": "^6.0.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.52.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@types/compression": "^1.7.5",
    "@types/csv-parse": "^1.2.5",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.0",
    "@types/pg-copy-streams": "^1.2.5",
    "autocannon": "^8.0.0",
    "k6": "^0.0.0",
    "prettier": "^3.3.3",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.1"
  },
  "packageManager": "bun@1.1.38",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
