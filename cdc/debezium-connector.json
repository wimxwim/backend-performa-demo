{
  "name": "gotongroyong-pg-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",
    "database.hostname": "postgres",
    "database.port": "5432",
    "database.user": "demo",
    "database.password": "demo123",
    "database.dbname": "gotongroyong_demo",
    "topic.prefix": "gotongroyong",
    "plugin.name": "pgoutput",
    "slot.name": "debezium",
    "publication.name": "dbz_publication",
    "publication.autocreate.mode": "filtered",
    "table.include.list": "public.umkm,public.masjid,public.financial_ledger",
    "column.include.list": "public.umkm.id,public.umkm.data_id,public.umkm.name,public.umkm.kelurahan,public.umkm.category0,public.umkm.category1,public.umkm.alamat,public.umkm.lat,public.umkm.lng,public.umkm.kecamatan_id,public.umkm.zip_code,public.umkm.created_at,public.masjid.id,public.masjid.name,public.masjid.tipe,public.masjid.kelurahan,public.masjid.lat,public.masjid.lng,public.masjid.alamat,public.financial_ledger.id,public.financial_ledger.community_id,public.financial_ledger.amount,public.financial_ledger.description,public.financial_ledger.timestamp,public.financial_ledger.hash_self",
    "tombstones.on.delete": "false",
    "provide.transaction.metadata": "true",
    "snapshot.mode": "initial",
