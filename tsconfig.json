{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false, // TODO strict:true after fixing any in shared/
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmit": true,
    "lib": ["ES2022"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/*"]
    }
  },
  "include": ["seed/**/*.ts", "shared/**/*.ts", "kas-service/src/demo-zis-rls.ts", "order-service/src/**/*.ts", "payment-service/src/**/*.ts", "umkm-service/src/**/*.ts", "kas-service/src/**/*.ts", "load/**/*.ts"],
  "exclude": ["node_modules", "presentasi", "dist"]
}
